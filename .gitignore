# Release signing - never commit the keystore or its passwords. Losing key.properties is
# recoverable (regenerate from the values you backed up separately); losing the .jks file
# itself is NOT - it's the one thing that proves future updates come from you.
android/key.properties
android/app/upload-keystore.jks
*.jks
*.keystore

